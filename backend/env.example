# macOS: port 5000 is often AirPlay Receiver (403 + Server: AirTunes). Use 5001 and add PORT=5001 to the repo root .env so Vite’s /api proxy matches.
PORT=5000

# Published WebAR: GLB files are stored under uploads/ar/ (auto-created). For Nginx reverse proxy, set
# client_max_body_size 80m; (or similar) on the /api location so publishes don’t return 413.
MONGO_URI=
JWT_SECRET=change-me-to-a-long-random-string
TRIPO_API_KEY=

CLIENT_URL=http://localhost:5173

# Credits (app-side; Tripo AI bills via your TRIPO_API_KEY)
DEFAULT_SIGNUP_CREDITS=100
# Optional signup promo
REFERRAL_MASTER_CODE=AdminKishan100%
REFERRAL_BONUS_CREDITS=500

# First account matching this email becomes admin (unlimited credit checks + grant UI)
ADMIN_EMAIL=
ADMIN_INITIAL_CREDITS=999999

